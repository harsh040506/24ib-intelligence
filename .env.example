# ─────────────────────────────────────────────────────────────
# 24IB Intelligence Platform — environment configuration
# Copy this file to `.env` and adjust. Never commit a real `.env`.
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite by default — zero setup. Point at Postgres for production.)
# SQLite:    sqlite:///intelligence.db
# Postgres:  postgresql+psycopg://user:pass@localhost:5432/intelligence
DATABASE_URL=sqlite:///intelligence.db

# Server
HOST=127.0.0.1
PORT=5000

# Scheduler: enable the in-process APScheduler for automated report generation
ENABLE_SCHEDULER=true

# Inc42 history workbook for the "Import history" button (optional override).
# By default the app looks for Inc42_Funding_Master_Data.xlsx next to / above it.
INC42_MASTER_PATH=

# Public static site (weekly + monthly only). When enabled, every weekly/monthly
# report is mirrored into PUBLISH_DIR (with its neighbours, archive index, and the
# home page) as it is generated. Set PUBLISH_ON_GENERATE=false to disable.
PUBLISH_ON_GENERATE=true
# PUBLISH_DIR=24IB-Private-Market-Research
